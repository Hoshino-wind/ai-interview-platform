    "typecheck": "pnpm --filter @ai-interview/shared-types build && tsc --noEmit"
  },
  "dependencies": {
    "@ai-interview/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
