// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  CANDIDATE
  INTERVIEWER
  HR
  ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum QuestionType {
  ALGORITHM
  SYSTEM_DESIGN
  REFACTOR
  DEBUG
  PROJECT
}

enum Difficulty {
  L1
  L2
  L3
  L4
}

enum ApplicationStatus {
  PENDING
  EXAM_SENT
  EXAM_COMPLETED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  REJECTED
}

enum ExamStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  SCORED
}

enum InterviewType {
  VIDEO
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Decision {
  RECOMMEND
  MAYBE
  REJECT
}

// Models
model User {
  id               String             @id @default(uuid())
  email            String             @unique
  phone            String?            @unique
  passwordHash     String
  role             UserRole           @default(CANDIDATE)
  name             String
  avatar           String?
  companyId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  resumes          Resume[]
  applications     Application[]
  interviewerScores InterviewerScore[]
  notifications    Notification[]

  @@index([email])
  @@index([companyId])
  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  createdAt   DateTime @default(now())

  // Relations
  users User[]
  jobs  Job[]

  @@map("companies")
}

model Job {
  id          String     @id @default(uuid())
  companyId   String
  title       String
  description String
  requirements String
  salaryRange String?
  status      JobStatus  @default(DRAFT)
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([companyId])
  @@index([status])
  @@map("jobs")
}

model Resume {
  id          String   @id @default(uuid())
  candidateId String
  fileUrl     String?
  parsedData  Json?
  skills      String[] @default([])
  experience  Json?
  education   Json?
  visibility  String   @default("private")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("resumes")
}

model Question {
  id                String       @id @default(uuid())
  type              QuestionType
  difficulty        Difficulty
  title             String
  description       String       @db.Text
  starterCode       Json?
  testCases         Json
  hiddenTestCases   Json?
  evaluationRubric  Json?
  timeLimit         Int          @default(3600)
  tags              String[]     @default([])
  languageSupport   String[]     @default(["javascript", "python"])
  aiScoringConfig   Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([type])
  @@index([difficulty])
  @@index([tags])
  @@map("questions")
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  jobId       String
  status      ApplicationStatus @default(PENDING)
  appliedAt   DateTime          @default(now())

  // Relations
  candidate   User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  exams       Exam[]
  interviews  Interview[]
  finalScore  FinalScore?

  @@index([candidateId])
  @@index([jobId])
  @@index([candidateId, jobId])
  @@index([status])
  @@map("applications")
}

model Exam {
  id           String          @id @default(uuid())
  applicationId String
  questionIds  String[]
  status       ExamStatus      @default(NOT_STARTED)
  startedAt    DateTime?
  submittedAt  DateTime?
  timeLimit    Int             @default(7200)
  createdAt    DateTime        @default(now())

  // Relations
  application  Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  submissions  ExamSubmission[]

  @@index([applicationId])
  @@index([status])
  @@map("exams")
}

model ExamSubmission {
  id           String      @id @default(uuid())
  examId       String
  questionId   String
  code         String      @db.Text
  language     String
  testResults  Json?
  codingEvents Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  exam         Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  aiScore      AIScore?

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@map("exam_submissions")
}

model AIScore {
  id                  String         @id @default(uuid())
  submissionId        String         @unique
  totalScore          Float
  breakdown           Json
  codeAnnotations     Json?
  suggestedQuestions  String[]       @default([])
  behaviorSummary     Json?
  createdAt           DateTime       @default(now())

  // Relations
  submission          ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([totalScore])
  @@map("ai_scores")
}

model Interview {
  id            String             @id @default(uuid())
  applicationId String
  interviewerIds String[]
  type          InterviewType      @default(VIDEO)
  scheduledAt   DateTime
  status        InterviewStatus    @default(SCHEDULED)
  createdAt     DateTime           @default(now())

  // Relations
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scores        InterviewerScore[]

  @@index([applicationId])
  @@index([status])
  @@index([scheduledAt])
  @@map("interviews")
}

model InterviewerScore {
  id              String    @id @default(uuid())
  interviewId     String
  interviewerId   String
  techDepth       Float
  communication   Float
  overallQuality  Float
  cultureFit      Float
  totalScore      Float
  comments        String?   @db.Text
  createdAt       DateTime  @default(now())

  // Relations
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer     User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([interviewerId])
  @@map("interviewer_scores")
}

model FinalScore {
  id            String      @id @default(uuid())
  applicationId String      @unique
  aiScore       Float
  interviewerScore Float
  finalScore    Float
  decision      Decision
  report        Json?
  createdAt     DateTime    @default(now())

  // Relations
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([decision])
  @@index([finalScore])
  @@map("final_scores")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}
